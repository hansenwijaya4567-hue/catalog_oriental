from flask import Flask, request, jsonify
import subprocess
import os
import uuid
import requests

app = Flask(__name__)

@app.route('/get-direct-url', methods=['POST'])
def get_direct_url():
    data = request.json
    youtube_url = data.get('url')

    if not youtube_url:
        return jsonify({"error": "URL YouTube tidak boleh kosong"}), 400

    output_filename = f"video_{uuid.uuid4().hex[:8]}.mp4"

    # Perintah yt-dlp untuk mengambil video max 1080p beserta audio
    command = [
        "yt-dlp",
        "-f", "bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best",
        "-o", output_filename,
        youtube_url
    ]

    try:
        # Eksekusi download ke server Render sementara
        subprocess.run(command, check=True)

        # Upload ke file.io untuk mendapatkan direct URL publik sementara
        with open(output_filename, 'rb') as f:
            upload_res = requests.post('https://file.io', files={'file': f})
        
        # Hapus file lokal dari server agar penyimpanan tidak penuh
        os.remove(output_filename)

        if upload_res.status_code == 200:
            direct_mp4_url = upload_res.json().get('link')
            return jsonify({
                "status": "sukses",
                "direct_mp4_url": direct_mp4_url
            })
        else:
            return jsonify({"error": "Gagal mengunggah file ke storage"}), 500

    except subprocess.CalledProcessError as e:
        return jsonify({"error": f"Gagal mendownload video: {str(e)}"}), 500

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
